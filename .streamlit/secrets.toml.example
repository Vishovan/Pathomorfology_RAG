# Streamlit Secrets Template для Pathology RAG
# Скопируйте этот файл в .streamlit/secrets.toml и укажите ваши ключи (не коммитьте secrets.toml в git):
# cp .streamlit/secrets.toml.example .streamlit/secrets.toml

# Самый быстрый бесплатный инференс (Llama 3.3 70B, ~500 токенов/сек):
# Получите бесплатный ключ на https://console.groq.com (без кредитной карты):
# GROQ_API_KEY = "gsk_..."

# Альтернативные бесплатные облачные провайдеры:
# GEMINI_API_KEY = "AIzaSy..."  # https://aistudio.google.com
# OPENROUTER_API_KEY = "sk-or-..."  # https://openrouter.ai

# Корпоративные российские провайдеры (152-ФЗ):
# GIGACHAT_CREDENTIALS = "..."
# GIGACHAT_SCOPE = "GIGACHAT_API_PERS"
# TLS: сертификаты GigaChat выпущены НУЦ Минцифры. Укажите путь к корневому сертификату
# (https://www.gosuslugi.ru/crt) — иначе соединение не пройдёт проверку:
# GIGACHAT_CA_BUNDLE = "/path/to/russian_trusted_root_ca.cer"
# Небезопасно, только для отладки: полностью отключить проверку сертификата
# GIGACHAT_VERIFY_SSL = "false"
